# Скопируйте этот файл в .env и подставьте значения из панели Supabase:
# Project Settings → API

PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Адрес сайта — нужен, чтобы ссылка из письма для входа вела куда надо.
# Локально: http://localhost:5173, на проде — адрес сайта.
PUBLIC_SITE_URL=http://localhost:5173
